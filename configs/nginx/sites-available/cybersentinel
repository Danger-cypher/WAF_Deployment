# =============================================================================
# CyberSentinel WAF — Dashboard Virtual Host Configuration
# Port 3020 → Direct WAF Dashboard access (plain HTTP, WAF-inspected)
# Port 3443 → Same dashboard over HTTPS (audit finding P1-06)
#
# Both server blocks below share one body (cybersentinel-console-body.inc)
# so ModSecurity rules, rate-limit zones and every location stay in sync —
# only `listen`/`server_name`/TLS-only directives differ between them.
#
# 3020 is kept alongside 3443 rather than replaced: nginx cannot have a
# `listen 3020 ssl;` server block and a `listen 3020;` (plain) server block
# both bound to the same port — only one server{} can own a given
# address:port combination, so migrating the console to HTTPS-only would
# have meant flipping 3020 straight over, breaking every current plain-HTTP
# session (including any tooling, bookmarks or SIEM redirect already
# pointed at http://...:3020) the moment it was applied, with no transition
# period. A second port sidesteps that restriction entirely: existing
# access over :3020 is completely unaffected, and admins can move to the
# HTTPS URL on their own schedule. :3020 can be firewalled off later once
# everyone has migrated, at which point this file can drop that block.
# =============================================================================

server {
    listen 3020;
    listen [::]:3020;
    server_name 192.168.2.70 localhost _;
    include /etc/nginx/sites-available/cybersentinel-console-body.inc;
}

server {
    listen 3443 ssl;
    listen [::]:3443 ssl;
    http2 on;
    server_name 192.168.2.70 localhost _;

    ssl_certificate     /etc/nginx/ssl/cybersentinel.crt;
    ssl_certificate_key /etc/nginx/ssl/cybersentinel.key;

    # Deliberately NOT sending Strict-Transport-Security here, unlike the
    # customer-facing :443 gateway (sites-enabled/mssp). HSTS is host-scoped,
    # not port-scoped: a browser that ever receives it from this host caches
    # it and then force-upgrades ALL subsequent requests to this host —
    # every port, including the still-plain-HTTP :3020 above — to HTTPS,
    # which that port doesn't speak. That would hang every request on
    # :3020 (including the SSO landing page) waiting on a TLS handshake it
    # will never get. Add it here only once :3020 is fully retired.

    include /etc/nginx/sites-available/cybersentinel-console-body.inc;
}
