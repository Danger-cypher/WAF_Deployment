# CyberSentinel WAF — Environment Configuration Template
# 
# SECURITY WARNING: DO NOT commit the actual .env file to version control!
# Copy this file to .env and replace all placeholder values with strong secrets.
#
# Generate strong secrets using:
#   openssl rand -hex 32
#   pwgen 32 1

# ============================================================================
# Redis Configuration
# ============================================================================
# IMPORTANT: Change this to a strong random password (minimum 32 characters)
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_32_CHARS_MIN
REDIS_HOST=redis

# ============================================================================
# JWT Authentication
# ============================================================================
# IMPORTANT: Generate a strong random secret using: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_HEX_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# GeoIP Configuration
# ============================================================================
GEOIP_DATA_DIR=/etc/nginx/geoip

# ============================================================================
# CORS Configuration
# ============================================================================
# Add your trusted frontend origins (comma-separated)
# Example: http://localhost:3001,https://waf.example.com
BACKEND_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://localhost,https://127.0.0.1

# ============================================================================
# ClickHouse Log Storage
# ============================================================================
# Core analytical database settings
CLICKHOUSE_HOST=waf-clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=wafuser
CLICKHOUSE_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD
CLICKHOUSE_DB=cybersentinel

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT
# ============================================================================
# [ ] Changed REDIS_PASSWORD to strong random value
# [ ] Changed CLICKHOUSE_PASSWORD to strong random value
# [ ] Changed JWT_SECRET_KEY to strong random value
# [ ] Updated BACKEND_CORS_ORIGINS with your actual domains
# [ ] Ensured .env is in .gitignore
# [ ] Changed default admin/analyst passwords via dashboard
# [ ] Reviewed backend/app/config/settings.json for sensitive data
