+const char *Transaction::getTxVariable(const std::string &name) {
+    std::unique_ptr<std::string> value =
+        m_collections.m_tx_collection->resolveFirst(name);
+    m_lastResolvedTxVariable = value ? *value : std::string();
+    return m_lastResolvedTxVariable.c_str();
+}
