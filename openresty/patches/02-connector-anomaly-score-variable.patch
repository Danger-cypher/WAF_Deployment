+/*
+ * Exposes ModSecurity's TX:BLOCKING_INBOUND_ANOMALY_SCORE as
+ * $modsecurity_anomaly_score so Lua (access_by_lua_file, which our own
+ * diagnostic confirmed always runs AFTER this module's NGX_HTTP_ACCESS_PHASE
+ * handler for the same request) can read the real CRS request-side score
+ * instead of the always-zero value it had no way to obtain before.
+ *
+ * NOTE: CRS v3 stored this as plain TX:ANOMALY_SCORE. CRS v4 (in use here)
+ * only ever increments TX:ANOMALY_SCORE from the RESPONSE phase
+ * (RESPONSE-980-CORRELATION.conf) — it is permanently 0 for any request
+ * that doesn't also trip a response-phase rule, which is useless here since
+ * this variable must be readable during the access phase, before a response
+ * exists. TX:BLOCKING_INBOUND_ANOMALY_SCORE is what CRS v4 actually
+ * accumulates during phase 1/2 (REQUEST-949-BLOCKING-EVALUATION.conf) and
+ * uses for its own blocking decision, so it's the correct signal here.
+ *
+ * NOTE 2: msc_get_tx_variable() calls Collection::resolveFirst() directly,
+ * which does a plain case-SENSITIVE std::multimap lookup on whatever key
+ * string a rule's setvar action stored — no case normalization. Variable
+ * parsing only uppercases the collection prefix ("TX"); the part after the
+ * colon/dot keeps the rule author's original case (src/variables/variable.cc
+ * Variable::Variable()). CRS writes this via lowercase SecLang
+ * ("setvar:'tx.blocking_inbound_anomaly_score=...'"), so the stored key is
+ * lowercase — even though CRS's own rules read it back as uppercase
+ * ("SecRule TX:BLOCKING_INBOUND_ANOMALY_SCORE...", which resolves through a
+ * different, case-insensitive code path used for normal rule evaluation).
+ * Querying uppercase here silently returns nothing. Must match the stored
+ * (lowercase) key exactly.
+ *
+ * Marked NOCACHEABLE because the value only becomes meaningful once
+ * msc_process_request_body() has run earlier in this same access phase —
+ * nginx must not reuse a stale/empty cached copy.
+ */
+static ngx_http_variable_t ngx_http_modsecurity_vars[] = {
+
+    { ngx_string("modsecurity_anomaly_score"), NULL,
+      ngx_http_modsecurity_variable_anomaly_score, 0,
+      NGX_HTTP_VAR_NOCACHEABLE, 0 },
+
+    ngx_http_null_variable
+};
+
+
+static ngx_int_t
+ngx_http_modsecurity_variable_anomaly_score(ngx_http_request_t *r,
+    ngx_http_variable_value_t *v, uintptr_t data)
+{
+    ngx_http_modsecurity_ctx_t *ctx;
+    const char *score;
+    u_char *dst;
+    size_t len;
+
+    ctx = ngx_http_get_module_ctx(r, ngx_http_modsecurity_module);
+    if (ctx == NULL || ctx->modsec_transaction == NULL) {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    score = msc_get_tx_variable(ctx->modsec_transaction,
+        "blocking_inbound_anomaly_score");
+    if (score == NULL || score[0] == '\0') {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    len = ngx_strlen(score);
+    dst = ngx_pnalloc(r->pool, len);
+    if (dst == NULL) {
+        return NGX_ERROR;
+    }
+    ngx_memcpy(dst, score, len);
+
+    v->len = len;
+    v->data = dst;
+    v->valid = 1;
+    v->no_cacheable = 0;
+    v->not_found = 0;
+
+    return NGX_OK;
+}
