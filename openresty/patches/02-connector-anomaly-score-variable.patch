+/*
+ * Exposes ModSecurity's TX:ANOMALY_SCORE as $modsecurity_anomaly_score so
+ * Lua (access_by_lua_file, which our own diagnostic confirmed always runs
+ * AFTER this module's NGX_HTTP_ACCESS_PHASE handler for the same request)
+ * can read the real CRS score instead of the always-zero value it had no
+ * way to obtain before. Marked NOCACHEABLE because the value only becomes
+ * meaningful once msc_process_request_body() has run earlier in this same
+ * access phase — nginx must not reuse a stale/empty cached copy.
+ */
+static ngx_http_variable_t ngx_http_modsecurity_vars[] = {
+
+    { ngx_string("modsecurity_anomaly_score"), NULL,
+      ngx_http_modsecurity_variable_anomaly_score, 0,
+      NGX_HTTP_VAR_NOCACHEABLE, 0 },
+
+    ngx_http_null_variable
+};
+
+
+static ngx_int_t
+ngx_http_modsecurity_variable_anomaly_score(ngx_http_request_t *r,
+    ngx_http_variable_value_t *v, uintptr_t data)
+{
+    ngx_http_modsecurity_ctx_t *ctx;
+    const char *score;
+    u_char *dst;
+    size_t len;
+
+    ctx = ngx_http_get_module_ctx(r, ngx_http_modsecurity_module);
+    if (ctx == NULL || ctx->modsec_transaction == NULL) {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    score = msc_get_tx_variable(ctx->modsec_transaction, "ANOMALY_SCORE");
+    if (score == NULL || score[0] == '\0') {
+        v->not_found = 1;
+        return NGX_OK;
+    }
+
+    len = ngx_strlen(score);
+    dst = ngx_pnalloc(r->pool, len);
+    if (dst == NULL) {
+        return NGX_ERROR;
+    }
+    ngx_memcpy(dst, score, len);
+
+    v->len = len;
+    v->data = dst;
+    v->valid = 1;
+    v->no_cacheable = 0;
+    v->not_found = 0;
+
+    return NGX_OK;
+}
+
+
